{
  "id": "/",
  "name": "Kravo Trading Journal",
  "short_name": "Kravo",
  "description": "Professional Android trading journal and performance analytics terminal for mobile traders.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#090B10",
  "theme_color": "#090B10",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity", "business"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Trade",
      "short_name": "+ Trade",
      "description": "Fast trade entry in under 1 minute",
      "url": "/?tab=journal",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
      "description": "View setup and strategy performance",
      "url": "/?tab=analytics",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Trading Calendar",
      "short_name": "Calendar",
      "description": "Monthly P&L calendar",
      "url": "/?tab=calendar",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
